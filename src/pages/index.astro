---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { bookByline, formatDate, ratingMarks } from '../lib/content.mjs';
import { url } from '../lib/url.mjs';

const books = (await getCollection('books')).sort(
  (a, b) => b.data.read_at.getTime() - a.data.read_at.getTime()
);
const chapters = await getCollection('chapters');
const chapterCount = (slug: string) => chapters.filter((c) => c.data.book === slug).length;
---

<Base
  title="독서 노트"
  description="읽은 책을 챕터 단위로 정리해 남기는 개인 독서 기록"
  current="books"
>
  <p class="page-lede">
    다 읽은 직후 한 번 정리해 두고, 이후에는 이 페이지들만 다시 본다. 원문은 올리지 않는다.
  </p>

  {
    books.length === 0 ? (
      <p class="meta">아직 올린 책이 없다.</p>
    ) : (
      <>
        {books.length > 1 && (
          <div class="sort-bar">
            <button type="button" class="pill-button" data-sort="recent" aria-pressed="true">
              읽은 순
            </button>
            <button type="button" class="pill-button" data-sort="rating" aria-pressed="false">
              평점 순
            </button>
          </div>
        )}

        <ul class="book-list" id="book-list">
          {books.map((book) => (
            <li
              class="book-card"
              data-read-at={book.data.read_at.toISOString()}
              data-rating={book.data.rating}
            >
              <a
                class="cover"
                href={url(`/books/${book.data.slug}/`)}
                aria-hidden="true"
                tabindex="-1"
              >
                {book.data.cover ? (
                  <img src={url(book.data.cover)} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="cover-blank">{book.data.title.slice(0, 1)}</span>
                )}
              </a>

              <div>
                <h2>
                  <a href={url(`/books/${book.data.slug}/`)}>{book.data.title}</a>
                </h2>
                <p class="meta">
                  {bookByline(book.data)}
                  {` · ${chapterCount(book.data.slug)}장`}
                  {` · ${formatDate(book.data.read_at)} 읽음`}
                  <span class="rating"> {ratingMarks(book.data.rating)}</span>
                </p>
                <p class="one-liner">{book.data.one_liner}</p>
                {book.data.tags.length > 0 && (
                  <ul class="tag-row">
                    {book.data.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<script>
  // 정적 페이지라 서버 왕복 없이 DOM 순서만 바꾼다.
  const list = document.getElementById('book-list');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.sort-bar button');

  if (list && buttons.length) {
    const items = Array.from(list.children) as HTMLElement[];

    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      recent: (a, b) => (a.dataset.readAt! < b.dataset.readAt! ? 1 : -1),
      rating: (a, b) =>
        Number(b.dataset.rating) - Number(a.dataset.rating) ||
        (a.dataset.readAt! < b.dataset.readAt! ? 1 : -1),
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        items.sort(sorters[button.dataset.sort!]).forEach((item) => list.appendChild(item));
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      });
    });
  }
</script>
