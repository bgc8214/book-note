---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { bookByline, formatDate, ratingMarks } from '../lib/content.mjs';
import { url } from '../lib/url.mjs';

const books = (await getCollection('books')).sort(
  (a, b) => b.data.read_at.getTime() - a.data.read_at.getTime()
);
const chapters = await getCollection('chapters');
const chapterCount = (slug: string) => chapters.filter((c) => c.data.book === slug).length;
---

<Base title="독서 노트" description="읽은 책을 챕터 단위로 정리해 남기는 개인 독서 기록">
  <section class="narrow" style="margin-bottom: 3.5rem">
    <p class="eyebrow">읽은 책</p>
    <p style="margin: 0; color: var(--muted)">
      다 읽은 직후 한 번 정리해 두고, 이후에는 이 페이지들만 다시 본다. 원문은 올리지 않는다.
    </p>
  </section>

  {
    books.length === 0 ? (
      <p class="meta">아직 올린 책이 없다.</p>
    ) : (
      <ul class="book-list">
        {books.map((book) => (
          <li class="book-card">
            <h2>
              <a href={url(`/books/${book.data.slug}/`)}>{book.data.title}</a>
            </h2>
            <p class="meta">
              {bookByline(book.data)}
              {book.data.original_title && ` · ${book.data.original_title}`}
              {` · ${chapterCount(book.data.slug)}장`}
              {` · 읽은 날 ${formatDate(book.data.read_at)}`}
              <span class="rating"> {ratingMarks(book.data.rating)}</span>
            </p>
            <p class="one-liner narrow">{book.data.one_liner}</p>
            {book.data.tags.length > 0 && (
              <ul class="tag-row">
                {book.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Base>
