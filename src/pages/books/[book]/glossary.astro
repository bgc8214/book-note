---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { url } from '../../../lib/url.mjs';
import Base from '../../../layouts/Base.astro';
import Disclaimer from '../../../components/Disclaimer.astro';

export async function getStaticPaths() {
  const books = await getCollection('books');
  const glossaries = await getCollection('glossaries');

  return glossaries.flatMap((glossary) => {
    const book = books.find((b) => b.data.slug === glossary.data.book);
    if (!book) return [];
    return [{ params: { book: book.data.slug }, props: { book, glossary } }];
  });
}

type Props = {
  book: CollectionEntry<'books'>;
  glossary: CollectionEntry<'glossaries'>;
};

const { book, glossary } = Astro.props;
const { Content } = await render(glossary);
---

<Base title={`용어집 — ${book.data.title}`} description={`《${book.data.title}》 용어집`}>
  <p class="crumbs">
    <a href={url('/')}>독서 노트</a> / <a href={url(`/books/${book.data.slug}/`)}>{book.data.title}</a> / 용어집
  </p>

  <article class="prose narrow">
    <p class="eyebrow">용어집</p>
    <h1>{book.data.title}</h1>
    <Content />
  </article>

  <Disclaimer title={book.data.title} buyUrl={book.data.buy_url} />
</Base>
