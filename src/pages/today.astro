---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { bullets } from '../lib/content.mjs';
import { url } from '../lib/url.mjs';

// 정리해둔 요점과 실천 아이템을 모아 매일 몇 개씩 다시 꺼내 본다.
// 사이트를 찾아가야만 다시 보게 되는 구조를 메우는 페이지다.
const books = await getCollection('books');
const bookOf = new Map(books.map((b) => [b.data.slug, b.data]));

const chapters = (await getCollection('chapters')).sort(
  (a, b) => a.data.book.localeCompare(b.data.book) || a.data.order - b.data.order
);

type Item = {
  kind: '요점' | '실천 아이템';
  text: string;
  bookTitle: string;
  chapterTitle: string;
  order: number;
  href: string;
};

const items: Item[] = [];

for (const chapter of chapters) {
  const book = bookOf.get(chapter.data.book);
  if (!book) continue;

  const source = {
    bookTitle: book.title,
    chapterTitle: chapter.data.title,
    order: chapter.data.order,
    href: url(`/books/${book.slug}/${chapter.data.slug}/`),
  };

  for (const text of bullets(chapter.body, '요점')) {
    items.push({ kind: '요점', text, ...source });
  }
  for (const text of bullets(chapter.body, '실천 아이템')) {
    items.push({ kind: '실천 아이템', text, ...source });
  }
}

const SHOWN = 5;
---

<Base title="오늘 다시 보기" description="정리해둔 요점과 실천 아이템을 매일 몇 개씩 다시 꺼내 본다">
  <section class="narrow" style="margin-bottom: 2rem">
    <p class="eyebrow">오늘 다시 보기</p>
    <p style="margin: 0; color: var(--muted)">
      쌓인 {items.length}개의 요점과 실천 아이템 중 {SHOWN}개. 날짜에 따라 자동으로 바뀐다.
    </p>
  </section>

  {
    items.length === 0 ? (
      <p class="meta">아직 꺼내 볼 것이 없다.</p>
    ) : (
      <>
        <ul class="review-list" id="review-list">
          {items.map((item) => (
            <li class="review-item">
              <p class="review-kind">{item.kind}</p>
              <p class="review-text">{item.text}</p>
              <p class="review-source">
                <a href={item.href}>
                  {item.bookTitle} · {item.order}장 {item.chapterTitle}
                </a>
              </p>
            </li>
          ))}
        </ul>

        <button type="button" class="reshuffle" id="reshuffle">다른 {SHOWN}개 보기</button>
      </>
    )
  }

  {/* 스크립트가 없으면 전부 보여준다. 그 편이 빈 페이지보다 낫다. */}
  <noscript>
    <style>
      .review-item { display: block !important; }
      .reshuffle { display: none; }
    </style>
  </noscript>
</Base>

<script define:vars={{ shown: SHOWN }}>
  // 같은 날에는 같은 항목이 나온다. 날짜를 시드로 쓰기 때문에 서버가 필요 없다.
  const list = document.getElementById('review-list');
  const button = document.getElementById('reshuffle');
  if (list) {
    const items = Array.from(list.children);

    const mulberry32 = (seed) => () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    const seedOf = (text) => {
      let h = 2166136261;
      for (const ch of text) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
      return h >>> 0;
    };

    /** 시드를 고정한 피셔-예이츠. 같은 시드면 같은 결과가 나온다. */
    const pick = (seed) => {
      const random = mulberry32(seed);
      const order = items.map((_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }
      return order.slice(0, shown);
    };

    const today = new Date().toLocaleDateString('sv-SE'); // YYYY-MM-DD, 로컬 기준
    let round = 0;

    const render = () => {
      const chosen = new Set(pick(seedOf(`${today}#${round}`)));
      items.forEach((item, i) => {
        item.style.display = chosen.has(i) ? 'block' : 'none';
      });
    };

    render();
    button?.addEventListener('click', () => {
      round += 1;
      render();
    });
  }
</script>
